{
  "name": "subway-irl",
  "private": true,
  "version": "0.1.0",
  "description": "An endless runner you play with your body: jog in place in front of your webcam to run through Mumbai. Browser-based, open source, runs entirely on your device.",
  "license": "MIT",
  "author": "Yash (https://github.com/Yashism)",
  "homepage": "https://yashism.github.io/Subway-IRL/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yashism/Subway-IRL.git"
  },
  "bugs": {
    "url": "https://github.com/Yashism/Subway-IRL/issues"
  },
  "keywords": [
    "game",
    "endless-runner",
    "pose-estimation",
    "mediapipe",
    "webcam",
    "threejs",
    "typescript",
    "vite",
    "fitness",
    "exergame",
    "mumbai"
  ],
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-mediapipe.mjs",
    "dev": "vite",
    "prelan": "node scripts/fetch-mediapipe.mjs",
    "lan": "node scripts/lan.mjs serve",
    "lan:forward": "node scripts/lan.mjs forward",
    "lan:stop": "node scripts/lan.mjs stop",
    "prebuild": "node scripts/fetch-mediapipe.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures:synth": "tsx scripts/make-synth-fixtures.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/three": "^0.186.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
